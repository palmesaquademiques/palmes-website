---
import ClubMap from '../components/contact/ClubMap.astro'
import PageHero from '../components/layout/PageHero.astro'
import RichText from '../components/rich-text/RichText.astro'
import JsonLd from '../components/seo/JsonLd.astro'
import Icon from '../components/ui/Icon.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { type ContactPage, contactPageQuery } from '../lib/queries'
import { plainTextOf } from '../lib/richText'
import { sanityQuery } from '../lib/sanity'
import { sportsClub } from '../lib/structuredData'
import { siteConfig } from '../site.config'

const page = await sanityQuery<ContactPage>(contactPageQuery)
const faq = page.faq ?? []

const faqCategories = Object.entries(Object.groupBy(faq, (entry) => entry.category ?? ''))

const faqStructuredData = {
  '@type': 'FAQPage',
  mainEntity: faq.map((entry) => ({
    '@type': 'Question',
    name: entry.question,
    acceptedAnswer: { '@type': 'Answer', text: plainTextOf(entry.answer) }
  }))
}
---

<BaseLayout
  headerTone="light"
  title="Contact"
  description="Venez nous voir le mardi soir à la piscine Léo Lagrange de Toulouse, ou écrivez-nous pour rejoindre le club."
  image="/og/contact.png"
>
  <JsonLd slot="head" data={sportsClub()} />
  {faq.length > 0 && <JsonLd slot="head" data={faqStructuredData} />}

  <PageHero
    kicker="Nous rejoindre"
    title="On vous attend au bord du bassin"
    intro="Une question, une envie d’essayer ? Passez nous voir un mardi soir ou écrivez-nous."
    image={page.bannerImage}
  />

  <section class="container-page grid gap-6 py-16 md:grid-cols-2 lg:grid-cols-3">
    <div class="grid overflow-hidden rounded-[1.75rem] bg-white ring-1 ring-ink/5 md:col-span-2 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:row-span-2">
      <div class="p-8">
        <Icon name="pin" class="size-7 text-lagoon" />
        <h2 class="mt-6 text-2xl font-semibold tracking-tight">Venir nous voir</h2>
        {page.address && <p class="mt-3 whitespace-pre-line text-slate-600">{page.address}</p>}
        {page.schedule && (
          <p class="mt-4 whitespace-pre-line text-sm font-medium text-ink">{page.schedule}</p>
        )}
      </div>
      {page.location && (
        <ClubMap latitude={page.location.lat} longitude={page.location.lng} class="min-h-72" />
      )}
    </div>

    <div class="rounded-[1.75rem] bg-white p-8 ring-1 ring-ink/5">
      <Icon name="mail" class="size-7 text-lagoon" />
      <h2 class="mt-6 text-2xl font-semibold tracking-tight">Nous écrire</h2>
      <a
        href={`mailto:${siteConfig.email}`}
        class="mt-3 block font-medium break-all text-ocean underline decoration-lagoon/40 underline-offset-4 hover:decoration-lagoon"
      >
        {siteConfig.email}
      </a>
      <p class="mt-4 text-sm text-slate-600">
        Et pour suivre la vie du club, rendez-vous sur{' '}
        <a
          href={siteConfig.instagram}
          class="font-medium text-ocean underline decoration-lagoon/40 underline-offset-4 hover:decoration-lagoon"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
        </a>
        .
      </p>
    </div>

    <a
      href="/inscriptions"
      data-join-card
      class="group flex flex-col justify-between rounded-[1.75rem] bg-gradient-to-br from-lagoon to-ocean p-8 text-white shadow-[0_20px_50px_-25px] shadow-ocean/70 transition hover:brightness-105"
    >
      <Icon name="users" class="size-7 text-white" />
      <div>
        <h2 class="mt-6 text-2xl font-semibold tracking-tight">Adhérer au club</h2>
        <p class="mt-3 text-white/85">Dates, tarifs, documents et inscription en ligne.</p>
        <span class="mt-6 flex size-11 items-center justify-center rounded-full bg-coral text-ink transition duration-500 ease-swim group-hover:-rotate-45">
          <Icon name="arrowRight" />
        </span>
      </div>
    </a>
  </section>

  {faq.length > 0 && (
    <section id="faq" class="container-page grid gap-12 py-20 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="kicker text-ocean">Vos questions</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">Questions fréquentes</h2>
      </div>
      <div class="space-y-12">
        {faqCategories.map(([category, entries]) => (
          <div>
            {category && (
              <h3 class="font-display text-2xl font-semibold tracking-tight">{category}</h3>
            )}
            <div class="mt-4 divide-y divide-ink/10 border-y border-ink/10">
              {(entries ?? []).map((entry) => (
                <details class="group py-2" name="faq">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 font-display text-xl font-semibold tracking-tight [&::-webkit-details-marker]:hidden">
                    {entry.question}
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-foam text-ocean transition duration-500 ease-swim group-open:rotate-45 group-open:bg-coral group-open:text-ink">
                      <Icon name="plus" class="size-4" />
                    </span>
                  </summary>
                  <RichText
                    value={entry.answer}
                    class="prose max-w-none pr-14 pb-5 prose-slate prose-p:my-2 prose-a:text-ocean prose-ul:my-2 prose-li:my-0.5"
                  />
                </details>
              ))}
            </div>
          </div>
        ))}
        <div class="flex flex-col gap-5 rounded-[1.75rem] bg-foam p-7 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-display text-xl font-semibold tracking-tight">Une autre question ?</p>
            <p class="mt-1 text-slate-600">
              Venez nous rencontrer un mardi soir au bord du bassin, ou écrivez-nous.
            </p>
          </div>
          <a href={`mailto:${siteConfig.email}`} class="button-dark shrink-0">
            <Icon name="mail" class="size-4" /> Nous écrire
          </a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
