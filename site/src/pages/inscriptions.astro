---
import PageHero from '../components/layout/PageHero.astro'
import HelloAssoWidget from '../components/rich-text/HelloAssoWidget.astro'
import RichText from '../components/rich-text/RichText.astro'
import Icon from '../components/ui/Icon.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { type MembershipPage, membershipPageQuery } from '../lib/queries'
import { sanityQuery } from '../lib/sanity'

const page = await sanityQuery<MembershipPage>(membershipPageQuery)
const keyDates = page.keyDates ?? []
const prices = page.prices ?? []
const checklist = page.checklist ?? []
---

<BaseLayout
  title={`Inscriptions ${page.season}`}
  description={page.intro ?? 'Toutes les informations pour rejoindre le club.'}
  image="/og/inscriptions.png"
>
  <PageHero kicker={`Saison ${page.season}`} title="Inscriptions" intro={page.intro}>
    <div class="mt-10 flex animate-fade-up flex-wrap gap-3 [animation-delay:360ms]">
      {page.helloAssoUrl && (
        <a href="#formulaire" class="button-primary">
          Je m’inscris <Icon name="arrowDown" class="size-4" />
        </a>
      )}
      <a href="/contact" class="button-ghost">
        Venir essayer un mardi
      </a>
    </div>
  </PageHero>

  {keyDates.length > 0 && (
    <section class="container-page py-20">
      <p class="kicker text-ocean">La rentrée</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">Les dates à retenir</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-3">
        {keyDates.map((keyDate) => (
          <li class="flex flex-col rounded-[1.75rem] bg-white p-7 ring-1 ring-ink/5">
            <p class="font-display text-lg font-semibold text-ocean">{keyDate.date}</p>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight">{keyDate.title}</h3>
            {keyDate.details && <p class="mt-3 text-slate-600">{keyDate.details}</p>}
            {keyDate.linkUrl && (
              <a
                href={keyDate.linkUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-auto inline-flex items-center gap-2 pt-6 font-medium text-ocean"
              >
                S’inscrire <Icon name="arrowRight" class="size-4" />
              </a>
            )}
          </li>
        ))}
      </ol>
    </section>
  )}

  {prices.length > 0 && (
    <section class="border-y border-ink/10 bg-white/50 py-20">
      <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:items-center">
        <div>
          <p class="kicker text-ocean">Tarifs</p>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">Combien ça coûte ?</h2>
          <RichText value={page.pricesNote} class="prose-palmes mt-6" />
        </div>
        <ul class="grid gap-5 sm:grid-cols-2">
          {prices.map((price) => (
            <li class="rounded-[1.75rem] bg-white p-8 ring-1 ring-ink/5">
              <p class="kicker text-ocean">{price.label}</p>
              <p class="mt-4 font-display text-6xl font-bold tracking-tight text-ink">
                {price.amount}
              </p>
              {price.note && <p class="mt-2 text-slate-500">{price.note}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {(checklist.length > 0 || page.goodToKnow) && (
    <section class="container-page py-20">
      <p class="kicker text-ocean">Avant de vous inscrire</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">À ne pas oublier</h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {checklist.map((item) => (
          <li class="rounded-[1.75rem] bg-white p-7 ring-1 ring-ink/5">
            <span class="flex size-10 items-center justify-center rounded-full bg-lagoon/15 text-ocean">
              <Icon name="check" class="size-5" />
            </span>
            <h3 class="mt-5 text-xl font-semibold tracking-tight">{item.title}</h3>
            <RichText
              value={item.details}
              class="prose mt-3 max-w-none prose-slate prose-p:my-2 prose-a:text-ocean"
            />
          </li>
        ))}
      </ul>
      {page.goodToKnow && (
        <div class="mt-12 rounded-[1.75rem] bg-white p-8 ring-1 ring-ink/5 sm:p-10">
          <h3 class="text-2xl font-semibold tracking-tight">Bon à savoir</h3>
          <RichText value={page.goodToKnow} class="prose-palmes mt-4" />
        </div>
      )}
    </section>
  )}

  {page.helloAssoUrl && (
    <section id="formulaire" class="scroll-mt-20 bg-foam py-20 sm:py-28">
      <div class="container-page max-w-4xl">
        <p class="kicker text-ocean">Adhésion en ligne</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
          Je m’inscris pour la saison {page.season}
        </h2>
        <p class="mt-4 max-w-2xl text-lg text-slate-600">
          Le paiement se fait en ligne, de façon sécurisée, sur HelloAsso, la plateforme de paiement
          des associations.
        </p>
        <HelloAssoWidget url={page.helloAssoUrl} />
      </div>
    </section>
  )}
</BaseLayout>
