---
import PageHero from '../components/layout/PageHero.astro'
import SanityImage from '../components/ui/SanityImage.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { type GalleryPage, type GalleryPhoto, galleryPageQuery } from '../lib/queries'
import { imageUrl, sanityQuery } from '../lib/sanity'

const tileShapes = {
  regular: { span: '', aspectRatio: 4 / 3, sizes: '(min-width: 1024px) 22rem, 50vw' },
  tall: { span: 'row-span-2', aspectRatio: 2 / 3, sizes: '(min-width: 1024px) 22rem, 50vw' },
  featured: {
    span: 'col-span-2 row-span-2',
    aspectRatio: 4 / 3,
    sizes: '(min-width: 1024px) 44rem, 100vw'
  },
  featuredTall: {
    span: 'col-span-2 row-span-3',
    aspectRatio: 7 / 8,
    sizes: '(min-width: 1024px) 44rem, 100vw'
  }
}

const shapeOf = (photo: GalleryPhoto) => {
  const isPortrait = photo.asset.metadata.dimensions.aspectRatio < 0.9
  if (photo.featured) return tileShapes[isPortrait ? 'featuredTall' : 'featured']
  return tileShapes[isPortrait ? 'tall' : 'regular']
}

const { intro, bannerImage, photos } = await sanityQuery<GalleryPage>(galleryPageQuery)
const galleryPhotos = (photos ?? []).map((photo) => ({
  ...photo,
  shape: shapeOf(photo),
  credit: photo.photographer ? `Photo : ${photo.photographer}` : null
}))
const galleryThemes = [
  { value: 'macro', label: 'Macro' },
  { value: 'divers', label: 'Plongeurs' },
  { value: 'blue', label: 'Grand bleu' }
].filter((theme) => galleryPhotos.some((photo) => photo.theme === theme.value))
---

<BaseLayout
  headerTone="light"
  title="Galerie photo"
  description={intro ?? 'Les photos de nos plongées et de la vie du club.'}
  image="/og/galerie.png"
>
  <PageHero
    kicker="Sous la surface"
    title="Galerie"
    intro={intro}
    image={bannerImage ?? photos?.[0]}
  />

  <section class="container-page py-16">
    {galleryThemes.length > 0 && (
      <div role="group" aria-label="Filtrer les photos" class="mb-8 flex flex-wrap gap-2">
        {[{ value: 'all', label: 'Toutes' }, ...galleryThemes].map((theme) => (
          <button
            type="button"
            data-gallery-filter={theme.value}
            aria-pressed={theme.value === 'all' ? 'true' : 'false'}
            class="rounded-full border border-ink/15 bg-white/60 px-4 py-2 text-sm font-medium text-ink/80 transition hover:border-ocean hover:text-ocean aria-pressed:border-ocean aria-pressed:bg-ocean aria-pressed:text-white"
          >
            {theme.label}
          </button>
        ))}
      </div>
    )}
    <div class="@container">
      <ul
        data-gallery-grid
        class="grid auto-rows-[calc((100cqw_-_0.75rem)/2*0.75)] grid-flow-dense grid-cols-2 gap-3 sm:auto-rows-[calc((100cqw_-_1rem)/2*0.75)] sm:gap-4 lg:auto-rows-[calc((100cqw_-_2rem)/3*0.75)] lg:grid-cols-3"
      >
        {galleryPhotos.map((photo) => (
          <li data-gallery-photo data-theme={photo.theme} class={photo.shape.span}>
            <a
              href={imageUrl(photo).width(2200).url()}
              data-lightbox="galerie"
              data-caption={[photo.alt, photo.credit].filter(Boolean).join(' · ')}
              class="group relative block size-full overflow-hidden rounded-2xl bg-deep"
            >
              <SanityImage
                image={photo}
                aspectRatio={photo.shape.aspectRatio}
                widths={[400, 640, 960, 1280, 1600]}
                sizes={photo.shape.sizes}
                class="size-full object-cover transition duration-[1.2s] ease-swim group-hover:scale-105"
              />
              {(photo.alt || photo.credit) && (
                <span class="absolute inset-x-0 bottom-0 translate-y-full bg-gradient-to-t from-abyss/90 to-transparent px-4 pt-10 pb-4 text-sm text-white transition duration-500 ease-swim group-hover:translate-y-0">
                  {photo.alt && <span class="block">{photo.alt}</span>}
                  {photo.credit && <span class="block text-xs text-white/70">{photo.credit}</span>}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  [data-gallery-photo] {
    transition:
      opacity 0.8s var(--ease-swim) var(--reveal-delay, 0s),
      translate 0.8s var(--ease-swim) var(--reveal-delay, 0s);
  }

  [data-reveal-ready] [data-gallery-photo]:not([data-revealed]) {
    opacity: 0;
    translate: 0 2rem;
  }
</style>

<script>
  const REVEAL_STAGGER_MILLISECONDS = 80

  const grid = document.querySelector<HTMLElement>('[data-gallery-grid]')!
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]')]
  const photos = [...document.querySelectorAll<HTMLElement>('[data-gallery-photo]')]
  const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)')

  const applyFilter = (theme: string) => {
    filters.forEach((filter) =>
      filter.setAttribute('aria-pressed', String(filter.dataset.galleryFilter === theme))
    )
    photos.forEach((photo) => {
      photo.hidden = theme !== 'all' && photo.dataset.theme !== theme
    })
  }

  const filterWithTransition = (theme: string) => {
    if (!document.startViewTransition || prefersReducedMotion.matches) {
      applyFilter(theme)
      return
    }
    photos.forEach((photo, photoIndex) => {
      photo.style.viewTransitionName = `gallery-photo-${photoIndex}`
    })
    document
      .startViewTransition(() => applyFilter(theme))
      .finished.finally(() => photos.forEach((photo) => (photo.style.viewTransitionName = '')))
  }

  filters.forEach((filter) =>
    filter.addEventListener('click', () => filterWithTransition(filter.dataset.galleryFilter!))
  )

  const revealObserver = new IntersectionObserver(
    (entries) =>
      entries
        .filter((entry) => entry.isIntersecting)
        .forEach((entry, entryIndex) => {
          const photo = entry.target as HTMLElement
          revealObserver.unobserve(photo)
          photo.style.setProperty('--reveal-delay', `${entryIndex * REVEAL_STAGGER_MILLISECONDS}ms`)
          photo.setAttribute('data-revealed', '')
        }),
    { rootMargin: '0px 0px -8% 0px' }
  )

  grid.setAttribute('data-reveal-ready', '')
  photos.forEach((photo) => revealObserver.observe(photo))
</script>
