---
import Crown from '../components/ui/Crown.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Poulpalmes, le jeu du poulpe"
  description="Propulsez le poulpe des Palmes Aquadémiques entre les rochers. Saurez-vous atteindre le niveau Moniteur ?"
  image="/og/jeu.png"
  bodyClass="bg-abyss"
>
  <section class="px-3 pt-[calc(var(--spacing-header)+0.75rem)] pb-6 sm:px-6">
    <div
      data-game
      class="relative mx-auto h-[calc(100svh-var(--spacing-header)-2rem)] max-h-[860px] max-w-6xl touch-none overflow-hidden rounded-[1.75rem] ring-1 ring-white/10 select-none"
    >
      <canvas
        data-game-canvas
        role="img"
        aria-label="Un poulpe nage dans l’océan entre des rochers couverts de corail"
        class="block size-full"
      ></canvas>

      <p
        data-game-score
        aria-hidden="true"
        hidden
        class="pointer-events-none absolute inset-x-0 top-6 text-center font-display text-7xl font-bold text-white [text-shadow:0_4px_24px_rgb(0_0_0/0.45)]"
      >
        0
      </p>

      <div
        data-game-start
        class="absolute inset-0 flex flex-col items-center gap-4 bg-[radial-gradient(ellipse_at_50%_25%,rgb(2_12_22/0.6),transparent_60%)] px-6 pt-12 text-center text-white sm:pt-16"
      >
        <p class="kicker text-lagoon">Le jeu du club</p>
        <h1 class="text-6xl font-bold tracking-tight sm:text-8xl">Poulpalmes</h1>
        <p class="max-w-sm text-lg text-white/80">
          Propulsez le poulpe entre les rochers, sans toucher le fond.
        </p>
        <button type="button" data-game-play class="button-primary mt-2">
          Plonger
        </button>
        <p class="text-sm text-white/60">Espace, clic ou toucher pour donner un coup de jet</p>
        <div class="mt-auto mb-6 flex justify-center gap-3 whitespace-nowrap sm:gap-4">
          <p
            data-game-personal-record
            hidden
            class="flex flex-col items-center justify-center rounded-2xl bg-abyss/70 px-4 py-2.5 ring-1 ring-white/15 backdrop-blur-sm sm:px-5"
          >
            <span class="font-display text-[0.65rem] font-semibold tracking-[0.15em] text-white/60 uppercase sm:text-xs">
              Votre record
            </span>
            <span
              data-game-personal-record-score
              class="font-display text-3xl font-bold text-lagoon"
            ></span>
            <span class="text-xs text-white/50">sur cet appareil</span>
          </p>
          <a
            href="#classement"
            data-game-club-record
            hidden
            class="relative flex flex-col items-center justify-center rounded-2xl bg-abyss/70 px-4 py-2.5 ring-1 ring-gold/40 backdrop-blur-sm transition duration-300 ease-swim hover:bg-deep/80 hover:ring-gold/70 sm:px-5"
          >
            <Crown
              uid="club-record"
              class="absolute -top-4 -left-3 w-9 -rotate-8 drop-shadow-[0_4px_10px_rgb(232_196_106/0.5)]"
            />
            <span class="font-display text-[0.65rem] font-semibold tracking-[0.15em] text-gold uppercase sm:text-xs">
              Record du club
            </span>
            <span
              data-game-club-record-score
              class="font-display text-3xl font-bold text-gold"
            ></span>
            <span class="max-w-28 truncate text-xs text-white/70 sm:max-w-36">
              par <span data-game-club-record-holder class="font-semibold text-white"></span>
            </span>
          </a>
        </div>
      </div>

      <div
        data-game-over
        hidden
        aria-live="polite"
        class="absolute inset-0 flex flex-col items-center justify-center gap-5 bg-abyss/55 px-6 text-center text-white backdrop-blur-sm"
      >
        <p class="kicker text-coral">Fin de plongée</p>
        <p data-game-message class="font-display text-4xl font-bold tracking-tight sm:text-5xl"></p>
        <dl class="flex gap-12">
          <div class="flex flex-col-reverse items-center gap-1">
            <dt class="kicker text-white/60">Score</dt>
            <dd data-game-final-score class="font-display text-6xl font-bold"></dd>
          </div>
          <div class="flex flex-col-reverse items-center gap-1">
            <dt class="kicker text-white/60">Record</dt>
            <dd data-game-record class="font-display text-6xl font-bold text-lagoon"></dd>
          </div>
        </dl>
        <p class="text-lg">
          Votre niveau : <strong data-game-level class="text-coral"></strong>
        </p>
        <p
          data-game-new-record
          hidden
          class="rounded-full bg-coral px-4 py-1 text-sm font-semibold text-ink"
        >
          Nouveau record !
        </p>
        <form data-game-submit hidden class="flex w-full max-w-sm gap-2">
          <label for="game-pseudonym" class="sr-only">
            Votre pseudo
          </label>
          <input
            id="game-pseudonym"
            data-game-pseudonym
            name="pseudonym"
            required
            minlength="2"
            maxlength="20"
            pattern="[\p{L}\p{N} '’._\-]{2,20}"
            title="De 2 à 20 lettres, chiffres ou espaces"
            autocomplete="nickname"
            placeholder="Votre pseudo"
            class="min-w-0 flex-1 rounded-full border border-white/30 bg-white/10 px-5 py-3 text-white placeholder:text-white/50"
          />
          <button type="submit" class="button-ghost">
            Enregistrer
          </button>
        </form>
        <p data-game-submit-status hidden class="text-sm text-white/80"></p>
        <div class="mt-2 flex flex-wrap justify-center gap-3">
          <button type="button" data-game-replay class="button-primary">
            Replonger
          </button>
          <a href="#classement" data-game-leaderboard-link hidden class="button-ghost">
            Classement
          </a>
          <a href="/" class="button-ghost">
            Retour au site
          </a>
        </div>
      </div>
    </div>

    <section
      id="classement"
      data-leaderboard
      hidden
      aria-labelledby="leaderboard-title"
      class="mx-auto mt-14 mb-20 max-w-lg scroll-mt-16 text-white"
    >
      <h2
        id="leaderboard-title"
        class="text-center text-3xl font-bold tracking-tight drop-shadow-[0_4px_10px_rgb(232_196_106/0.35)] sm:text-4xl"
      >
        <span class="bg-gradient-to-b from-[#fff0bd] via-gold to-[#a87a1f] box-decoration-clone bg-clip-text text-transparent">
          Tableau d’honneur du royaume
        </span>
      </h2>
      <div class="relative mt-10">
        <Crown
          uid="leaderboard"
          class="absolute -top-6 left-2 w-11 -rotate-8 drop-shadow-[0_4px_10px_rgb(232_196_106/0.5)]"
        />
        <ol
          data-leaderboard-list
          class="divide-y divide-white/10 rounded-3xl bg-white/5 px-6 ring-1 ring-white/10"
        ></ol>
      </div>
    </section>
  </section>

  <template data-leaderboard-entry>
    <li class="group flex items-baseline gap-4 py-3 data-current-player:text-coral">
      <span data-rank class="w-6 font-display text-white/50 group-first:text-gold"></span>
      <span data-pseudonym class="flex-1 truncate font-semibold"></span>
      <span
        data-score
        class="font-display text-2xl font-bold text-lagoon group-first:text-gold"
      ></span>
    </li>
  </template>
</BaseLayout>

<script>
  import '../scripts/octopus-game/game'
</script>
