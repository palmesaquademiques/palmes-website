---
import type { Emblem } from '../../lib/queries'

type Props = { emblem: Emblem; uid: string }

const { emblem, uid } = Astro.props

const coins = [
  { x: -115, peak: -120, fall: 110, delay: 0 },
  { x: -75, peak: -150, fall: 125, delay: 0.06 },
  { x: -30, peak: -170, fall: 135, delay: 0.12 },
  { x: 25, peak: -165, fall: 130, delay: 0.04 },
  { x: 70, peak: -145, fall: 120, delay: 0.1 },
  { x: 110, peak: -115, fall: 105, delay: 0.16 }
]

const certificates = [
  { label: 'N1', x: -34, delay: 0 },
  { label: 'N2', x: 0, delay: 0.35 },
  { label: 'N3', x: 34, delay: 0.7 }
]

const TENTACLE_PATH = 'M8 80C4 62 13 52 23 46s19-14 17-26c-1-7-8-9-12-5-3 3-1 8 4 7'

const TENTACLE_SUCKERS = [
  [12, 70, 1.9],
  [14, 59, 1.8],
  [21, 50, 1.6],
  [30, 44, 1.4],
  [37, 36, 1.2]
]

const SEAHORSE_OUTLINE =
  'M10 17.5C14 16.5 20 15.5 26 14.5 27 10 30 6.5 35 6L36 2.5 38.5 5.5 41 3 42 7.5C45 9 46.5 13 45.5 17 45 20 43.5 22 43 24 47 28 50 35 49.5 43 49 51 46 58 41 63L33 64C27 59 21 52 21 44 21 36 25 30 30 27.5 27 26 25 24.5 24 22.5 19 22.5 14 22.5 10 22 8.5 21.5 8 18.5 10 17.5Z'

const SEAHORSE_TAIL = 'M37 60c1 10-1 19-7 25-5 5-12 3-12-3 0-5 5-7 8-4 2 2 0 5-2 4'

const ANGER_MARK = 'M19 9Q30 24 41 9M51 19Q36 30 51 41M41 51Q30 36 19 51M9 41Q24 30 9 19'

const angerMarks = [
  { position: '-top-[6%] -right-[10%] w-[30%]', delay: 0 },
  { position: 'top-[14%] -left-[8%] w-[18%]', delay: 0.35 }
]

const cameraFlashes = [
  { position: '-top-[8%] left-[92%] w-[44%]', delay: 0.5 },
  { position: '-top-[2%] -left-[20%] w-[34%]', delay: 0.85 },
  { position: 'bottom-[12%] -left-[16%] w-[28%]', delay: 1.15 }
]

const finBubbles = [
  { position: 'top-[92%] left-[108%] size-[12%]', delay: 0.4 },
  { position: 'top-[100%] left-[116%] size-[8%]', delay: 0.5 },
  { position: 'top-[86%] left-[120%] size-[7%]', delay: 0.62 }
]

const OCTOPUS_TENTACLES = [
  'M-16 8Q-23 28-31 42q4 3 6-2',
  'M-10 8Q-14 28-18 42q4 3 6-2',
  'M-3 8Q-5 28-6 42q4 3 6-2',
  'M3 8Q5 28 6 42q4 3 6-2',
  'M10 8Q14 28 18 42q4 3 6-2',
  'M16 8Q23 28 31 42q4 3 6-2'
]

const OCTOPUS_MUSTACHE =
  'M0 11.5C-4 9-9 9.5-12 12-14 13.5-17 13-18 10-18.5 14.5-15 17.5-11 16.5-7 15.5-3 14.5 0 14 3 14.5 7 15.5 11 16.5 15 17.5 18.5 14.5 18 10 17 13 14 13.5 12 12 9 9.5 4 9 0 11.5Z'

const HEART = 'M0 4.5-5-.5A2.8 2.8 0 0 1 0-3 2.8 2.8 0 0 1 5-.5Z'

const octopusHearts = [
  { position: 'top-[26%] -left-[2%] w-[11%]', delay: 1.1 },
  { position: 'top-[30%] -left-[17%] w-[8%]', delay: 1.7 }
]

const HEADBAND = 'M9 22Q50 36 91 22'

const HEADBAND_TAILS = [
  { path: 'M91 22c8-3 14 1 20-1s10-6 16-3', delay: 0 },
  { path: 'M91 23c6 4 10 10 16 11s9 3 12 7', delay: -0.15 }
]

const speedLines = [
  { position: 'top-[28%] w-[70%]', delay: 0 },
  { position: 'top-[47%] w-[95%]', delay: 0.06 },
  { position: 'top-[66%] w-[60%]', delay: 0.12 }
]

const dustPuffs = [
  { position: 'bottom-[2%] -left-[4%] size-[16%]', delay: 1.25 },
  { position: 'bottom-[14%] -left-[12%] size-[11%]', delay: 1.32 },
  { position: '-bottom-[4%] left-[10%] size-[10%]', delay: 1.38 }
]

const tentacleAccessories: Partial<Record<Emblem, 'coin' | 'quill' | 'inkwell'>> = {
  tentacleCoin: 'coin',
  tentacleQuill: 'quill',
  tentacleInkwell: 'inkwell'
}

const tentacleAccessory = tentacleAccessories[emblem]
---

<span
  aria-hidden={emblem === 'crown' ? undefined : 'true'}
  class="emblem pointer-events-none absolute inset-0"
>
  {emblem === 'crown' && (
    <>
      <button
        type="button"
        popovertarget={`decree-${uid}`}
        aria-label="Lire le décret royal"
        class="emblem-crown absolute -top-[24%] left-1/2 w-[44%] -translate-x-1/2 cursor-pointer"
      >
        <svg viewBox="0 0 64 46" class="w-full drop-shadow-[0_4px_10px_rgb(232_196_106/0.5)]">
          <defs>
            <linearGradient id={`crown-gold-${uid}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#fff0bd" />
              <stop offset="0.5" stop-color="#e8c46a" />
              <stop offset="1" stop-color="#a87a1f" />
            </linearGradient>
          </defs>
          <path
            d="M7 37 3 11l15 12L32 5l14 18 15-12-4 26Z"
            fill={`url(#crown-gold-${uid})`}
            stroke="#7a5612"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
          <rect
            x="6"
            y="35"
            width="52"
            height="8"
            rx="2"
            fill={`url(#crown-gold-${uid})`}
            stroke="#7a5612"
            stroke-width="1.5"
          />
          <circle cx="32" cy="27" r="4" fill="#ff5a7a" />
          <circle cx="18" cy="30" r="2.8" fill="#2ba7de" />
          <circle cx="46" cy="30" r="2.8" fill="#2ba7de" />
          <circle cx="3" cy="11" r="2.6" fill="#fff0bd" />
          <circle cx="32" cy="5" r="3" fill="#fff0bd" />
          <circle cx="61" cy="11" r="2.6" fill="#fff0bd" />
        </svg>
        <span class="emblem-sparkle absolute -top-1 right-0 text-sm text-white">✦</span>
      </button>
      <span
        popover
        id={`decree-${uid}`}
        class="m-auto max-w-xs rounded-2xl bg-[#f4e7c5] px-7 py-6 text-center text-ink shadow-2xl ring-1 ring-[#a57f2c]/40 backdrop:bg-abyss/60 backdrop:backdrop-blur-sm"
      >
        <span class="block text-3xl">📜</span>
        <span class="mt-3 block font-display text-xl leading-snug font-semibold">
          Par décret royal, le mardi soir est jour de piscine.
        </span>
        <span class="mt-3 block text-sm text-ink/60 italic">La Reine des Palmes</span>
      </span>
    </>
  )}

  {emblem === 'coins' &&
    coins.map((coin) => (
      <span
        class="emblem-coin absolute top-1/2 left-1/2 w-[15%] -translate-1/2"
        style={`--coin-x:${coin.x}px; --coin-peak:${coin.peak}px; --coin-fall:${coin.fall}px; animation-delay:${coin.delay}s`}
      >
        <svg viewBox="0 0 20 20" class="w-full">
          <circle cx="10" cy="10" r="9" fill="#e8c46a" stroke="#8a6512" stroke-width="1.4" />
          <circle cx="10" cy="10" r="5.5" fill="none" stroke="#fff0bd" stroke-width="1.2" />
          <path
            d="M6 6.5a5 5 0 0 1 4-2"
            stroke="#fff"
            stroke-width="1.4"
            stroke-linecap="round"
            fill="none"
          />
        </svg>
      </span>
    ))}

  {emblem === 'seal' && (
    <span class="emblem-seal absolute -right-[6%] bottom-[2%] w-[32%] -rotate-12">
      <svg viewBox="0 0 48 48" class="w-full drop-shadow-[0_3px_6px_rgb(0_0_0/0.4)]">
        <path
          d="M24 2c4 0 5 3 8 4s6-1 8 2-1 6 1 9 5 4 4 8-4 4-4 7 2 6-1 8-6 0-9 2-4 5-7 5-5-3-8-4-6 1-8-2 1-6-1-9-5-4-4-8 4-4 4-7-2-6 1-8 6 0 9-2 4-5 7-5Z"
          fill="#b3263a"
        />
        <circle cx="24" cy="24" r="12" fill="#9a1d30" stroke="#d6485c" stroke-width="1.5" />
        <text
          x="24"
          y="30"
          text-anchor="middle"
          font-size="16"
          font-weight="800"
          fill="#e8768a"
          font-family="ui-serif, Georgia, serif"
        >
          P
        </text>
      </svg>
    </span>
  )}

  {emblem === 'dolphin' && (
    <span class="emblem-dolphin absolute top-1/2 left-1/2 w-[46%] -translate-1/2">
      <svg viewBox="0 0 100 48" class="w-full drop-shadow-[0_3px_6px_rgb(0_0_0/0.4)]">
        <defs>
          <linearGradient id={`dolphin-${uid}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3f7ea8" />
            <stop offset="0.5" stop-color="#6fa8c9" />
            <stop offset="0.75" stop-color="#cfe6f2" />
            <stop offset="1" stop-color="#eef7fb" />
          </linearGradient>
        </defs>
        <path d="M60 13C58 7 54 3 48 1c3 5 4 9 2 13Z" fill="#3a76a0" />
        <path d="M75 31c-1 6-5 10-11 12 3-4 5-8 5-12Z" fill="#3a76a0" />
        <path
          d="M98 33c-3-2-6-3-8-4 0-5-3-9-8-10-8-4-18-7-28-6-12 1-24 5-32 12-4 3-7 5-10 5-3-4-6-6-10-7 3 5 5 8 7 10-3 3-5 6-7 10 5-2 9-5 12-8 8-2 16-4 26-5 14-1 30 1 42 3 6 1 11 2 15 1Z"
          fill={`url(#dolphin-${uid})`}
        />
        <path
          d="M97.5 33.4c-3 .3-6 0-9-1"
          stroke="#2c5f80"
          stroke-width="0.8"
          fill="none"
          stroke-linecap="round"
        />
        <circle cx="84.5" cy="25" r="1.3" fill="#0a1826" />
      </svg>
    </span>
  )}

  {tentacleAccessory && (
    <span class="emblem-tentacle absolute -bottom-[10%] -left-[16%] w-[48%]">
      <svg
        viewBox="0 0 60 80"
        class="w-full overflow-visible drop-shadow-[0_2px_4px_rgb(0_0_0/0.5)]"
      >
        <defs>
          <mask
            id={`tentacle-reveal-${uid}`}
            maskUnits="userSpaceOnUse"
            x="-10"
            y="-20"
            width="80"
            height="110"
          >
            <path
              class="emblem-tentacle-reveal"
              d={TENTACLE_PATH}
              pathLength="1"
              fill="none"
              stroke="white"
              stroke-width="18"
              stroke-linecap="round"
            />
          </mask>
        </defs>

        <g mask={`url(#tentacle-reveal-${uid})`} fill="none" stroke-linecap="round">
          <path
            d={TENTACLE_PATH}
            pathLength="1"
            stroke="#e8613f"
            stroke-width="10"
            stroke-dasharray="0.45 1"
          />
          <path
            d={TENTACLE_PATH}
            pathLength="1"
            stroke="#ff7a59"
            stroke-width="7.5"
            stroke-dasharray="0.75 1"
          />
          <path d={TENTACLE_PATH} pathLength="1" stroke="#ff7a59" stroke-width="4.5" />
          <path
            d={TENTACLE_PATH}
            pathLength="1"
            stroke="#ffb39a"
            stroke-width="1.6"
            stroke-dasharray="0.6 1"
            transform="translate(-1.5 -1)"
          />
          {TENTACLE_SUCKERS.map(([x, y, radius]) => (
            <circle cx={x} cy={y} r={radius} fill="#ffd2c4" stroke="#e8613f" stroke-width="0.6" />
          ))}
        </g>
        {tentacleAccessory === 'coin' && (
          <g class="emblem-accessory">
            <circle cx="35" cy="6" r="8" fill="#e8c46a" stroke="#8a6512" stroke-width="1.6" />
            <circle cx="35" cy="6" r="4.8" fill="none" stroke="#fff0bd" stroke-width="1.3" />
          </g>
        )}
        {tentacleAccessory === 'quill' && (
          <g class="emblem-accessory">
            <path
              d="M33 12c6-14 15-22 26-28-3 11-11 20-22 29Z"
              fill="#f4f1e8"
              stroke="#8d8577"
              stroke-width="1.2"
            />
            <path d="M31 17 57-14" stroke="#5f584d" stroke-width="1.4" stroke-linecap="round" />
          </g>
        )}
        {tentacleAccessory === 'inkwell' && (
          <g class="emblem-accessory">
            <rect
              x="31"
              y="-8"
              width="9"
              height="6"
              rx="1.2"
              fill="#2b3b5c"
              stroke="#9fb3d1"
              stroke-width="1"
            />
            <path
              d="M26 -2h19v11a4 4 0 0 1-4 4H30a4 4 0 0 1-4-4Z"
              fill="#1b2a4a"
              stroke="#9fb3d1"
              stroke-width="1.3"
            />
            <rect x="28.5" y="2" width="14" height="4.5" rx="1" fill="#e8c46a" />
          </g>
        )}
      </svg>
    </span>
  )}

  {emblem === 'certificates' &&
    certificates.map((certificate) => (
      <span
        class="emblem-certificate absolute top-[4%] left-1/2 flex size-[30%] -translate-x-1/2 items-center justify-center rounded-full border-2 border-white/80 bg-lagoon/45 font-display text-sm font-bold text-white shadow-[0_0_18px_rgb(43_167_222/0.6)] backdrop-blur-sm"
        style={`--certificate-x:${certificate.x}px; animation-delay:${certificate.delay}s`}
      >
        {certificate.label}
      </span>
    ))}

  {emblem === 'loanTag' && (
    <span class="emblem-tag absolute top-[42%] -right-[30%] w-[48%] origin-top-left rotate-6">
      <svg
        viewBox="0 0 70 40"
        class="w-full overflow-visible drop-shadow-[0_3px_5px_rgb(0_0_0/0.35)]"
      >
        <path d="M0 2 14 12" stroke="#e8c46a" stroke-width="1.5" />
        <path d="M14 12 24 4h44v26H24Z" fill="#f4e7c5" stroke="#a57f2c" stroke-width="1.2" />
        <circle cx="22" cy="17" r="2.2" fill="none" stroke="#a57f2c" stroke-width="1.2" />
        <text
          x="46"
          y="22"
          text-anchor="middle"
          font-size="10"
          font-weight="700"
          fill="#0a1826"
          font-family="Inter Variable, sans-serif"
        >
          Prêté ✓
        </text>
      </svg>
    </span>
  )}

  {emblem === 'champagne' && (
    <span class="emblem-champagne absolute -top-[30%] left-1/2 w-[56%] -translate-x-1/2">
      <svg viewBox="0 0 70 52" class="w-full overflow-visible">
        <g class="emblem-glass-left">
          <path
            d="M8 6h20l-4 12a6 6 0 0 1-12 0Z"
            fill="rgb(232 196 106 / 0.8)"
            stroke="#fff"
            stroke-width="1.4"
          />
          <path d="M18 24v16M11 42h14" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
        </g>
        <g class="emblem-glass-right">
          <path
            d="M42 6h20l-4 12a6 6 0 0 1-12 0Z"
            fill="rgb(232 196 106 / 0.8)"
            stroke="#fff"
            stroke-width="1.4"
          />
          <path d="M52 24v16M45 42h14" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
        </g>
        <text class="emblem-cheers" x="35" y="4" text-anchor="middle" font-size="9" fill="#fff0bd">
          ✦
        </text>
      </svg>
    </span>
  )}

  {emblem === 'compass' && (
    <span class="emblem-compass absolute bottom-[0%] -left-[8%] w-[32%]">
      <svg viewBox="0 0 40 40" class="w-full drop-shadow-[0_3px_6px_rgb(0_0_0/0.4)]">
        <circle cx="20" cy="20" r="18" fill="#0a1826" stroke="#e8c46a" stroke-width="2" />
        <path d="M20 4 24 20 20 36 16 20Z" fill="#e8c46a" />
        <path d="M20 4 24 20h-8Z" fill="#ff5a5a" />
        <path d="M4 20 20 17l16 3-16 3Z" fill="#cfd8de" />
        <circle cx="20" cy="20" r="2.2" fill="#fff0bd" />
      </svg>
    </span>
  )}

  {emblem === 'seahorse' && (
    <span class="emblem-seahorse absolute top-[0%] -right-[28%] w-[38%]">
      <svg
        viewBox="0 0 60 100"
        class="w-full overflow-visible drop-shadow-[0_3px_6px_rgb(0_0_0/0.45)]"
      >
        <defs>
          <linearGradient id={`seahorse-body-${uid}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffd76e" />
            <stop offset="0.5" stop-color="#ffa64d" />
            <stop offset="1" stop-color="#f0703f" />
          </linearGradient>
          <radialGradient id={`seahorse-belly-${uid}`} cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="#fff3c4" stop-opacity="0.75" />
            <stop offset="1" stop-color="#fff3c4" stop-opacity="0" />
          </radialGradient>
          <clipPath id={`seahorse-clip-${uid}`}>
            <path d={SEAHORSE_OUTLINE} />
          </clipPath>
        </defs>

        {[0, 1, 2].map((bubbleIndex) => (
          <circle
            class="seahorse-bubble"
            cx={7 - bubbleIndex}
            cy="17"
            r={1.2 + bubbleIndex * 0.4}
            fill="none"
            stroke="white"
            stroke-width="0.6"
            style={`animation-delay:${bubbleIndex * 0.7}s`}
          />
        ))}

        <g class="seahorse-fin">
          <path
            d="M48 35c7 1 10 7 8 15-3-1-6-2-9-2Z"
            fill="rgb(255 226 150 / 0.75)"
            stroke="#e8a23f"
            stroke-width="0.6"
          />
          <path
            d="M48 37.5 55 40M48 40.5 56.5 44M48 43.5 56.5 47.5M48 46.5 54.5 49.5"
            stroke="#e8a23f"
            stroke-width="0.5"
          />
        </g>

        <g class="seahorse-tail" fill="none" stroke-linecap="round">
          <path
            d={SEAHORSE_TAIL}
            pathLength="1"
            stroke="#f58a45"
            stroke-width="9"
            stroke-dasharray="0.35 1"
          />
          <path
            d={SEAHORSE_TAIL}
            pathLength="1"
            stroke="#f58a45"
            stroke-width="6.5"
            stroke-dasharray="0.62 1"
          />
          <path d={SEAHORSE_TAIL} pathLength="1" stroke="#f58a45" stroke-width="4" />
          <path
            d={SEAHORSE_TAIL}
            pathLength="1"
            stroke="#c4471f"
            stroke-width="3.6"
            stroke-dasharray="0.012 0.045"
            opacity="0.55"
          />
        </g>

        <path
          d={SEAHORSE_OUTLINE}
          fill={`url(#seahorse-body-${uid})`}
          stroke="#c4471f"
          stroke-width="0.9"
          stroke-linejoin="round"
        />
        <g clip-path={`url(#seahorse-clip-${uid})`}>
          <ellipse cx="26.5" cy="44" rx="7" ry="15" fill={`url(#seahorse-belly-${uid})`} />
          <path
            d="M45 30c-6 1-13 1-20 3M48 37c-7 1-16 1-26 2M49 44c-8 1-18 2-28 2M47 51c-6 1-14 2-24 1M43 57c-5 1-11 1-16 0"
            stroke="#c4471f"
            stroke-width="0.9"
            fill="none"
            opacity="0.55"
          />
        </g>
        <path
          d="M43 21.5c3-1 4.5 1 3.2 3.4-1.4 0-2.5-.8-3.2-1.8Z"
          fill="rgb(255 226 150 / 0.55)"
          stroke="#e8a23f"
          stroke-width="0.4"
        />
        {[
          [38, 12],
          [44, 29],
          [41, 50]
        ].map(([x, y]) => (
          <circle cx={x} cy={y} r="0.9" fill="#d9572f" opacity="0.7" />
        ))}
        <circle cx="33" cy="13" r="2.7" fill="#fff" stroke="#c4471f" stroke-width="0.6" />
        <circle cx="32.4" cy="13.2" r="1.5" fill="#0a1826" />
        <circle cx="32" cy="12.6" r="0.5" fill="#fff" />
        <circle cx="9.6" cy="19.8" r="0.7" fill="#7a2a12" />
      </svg>
    </span>
  )}

  {emblem === 'cameraFlash' && (
    <>
      <span class="emblem-flash-glare absolute inset-[3px] rounded-full bg-white" />
      <span class="emblem-camera absolute top-[4%] -right-[22%] w-[36%]">
        <svg
          viewBox="0 0 64 48"
          class="w-full overflow-visible drop-shadow-[0_3px_6px_rgb(0_0_0/0.35)]"
        >
          <rect
            x="18"
            y="3"
            width="17"
            height="9"
            rx="2.5"
            fill="#1c2733"
            stroke="white"
            stroke-width="2"
          />
          <rect
            x="5"
            y="5"
            width="9"
            height="6"
            rx="1.5"
            fill="#e5342b"
            stroke="white"
            stroke-width="1.5"
          />
          <rect
            x="2"
            y="9"
            width="60"
            height="35"
            rx="7"
            fill="#1c2733"
            stroke="white"
            stroke-width="2.5"
          />
          <rect x="45" y="14" width="11" height="7" rx="1.5" fill="#fff6cc" />
          <circle cx="30" cy="27" r="12" fill="#0a1826" stroke="#8fa3b3" stroke-width="3" />
          <circle cx="30" cy="27" r="6" fill="#2ba7de" opacity="0.7" />
          <circle cx="26.5" cy="23.5" r="2.2" fill="white" opacity="0.85" />
        </svg>
      </span>
      {cameraFlashes.map((flash, flashIndex) => (
        <span
          class:list={['emblem-flash absolute', flash.position]}
          style={`animation-delay:${flash.delay}s`}
        >
          <svg
            viewBox="0 0 40 40"
            class="w-full overflow-visible drop-shadow-[0_0_5px_rgb(232_196_106/0.95)]"
          >
            <defs>
