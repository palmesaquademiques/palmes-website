---
import type { Member } from '../../lib/queries'
import { groupTeam, instructorLevels, instructorTitleOf } from '../../lib/team'
import Bubbles from '../ui/Bubbles.astro'
import MemberMedallion from './MemberMedallion.astro'

type Props = { members: Member[] }

const { board, committee, poolInstructors, seaInstructors } = groupTeam(Astro.props.members)

const instructorGroups = [
  {
    title: 'À la piscine',
    description: 'Les initiateurs forment les futurs niveaux 1, le mardi soir.',
    members: poolInstructors
  },
  {
    title: 'En mer',
    description: 'Moniteurs et guides de palanquée encadrent les plongées des sorties.',
    members: seaInstructors
  }
].filter((group) => group.members.length > 0)
---

<section
  id="equipe"
  data-team
  class="relative isolate overflow-clip bg-abyss py-24 text-white sm:py-32"
>
  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-0 -z-10 h-[40rem] bg-[radial-gradient(ellipse_at_50%_0%,rgb(232_196_106/0.14),transparent_60%)]"
  ></div>
  <img
    src="/logo.png"
    alt=""
    aria-hidden="true"
    width="192"
    height="192"
    loading="lazy"
    class="pointer-events-none absolute top-10 left-1/2 -z-10 w-[min(36rem,90vw)] -translate-x-1/2 opacity-[0.05] grayscale"
  />
  <Bubbles count={10} />
  <div
    data-bubble-rain
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-40 overflow-hidden"
  ></div>

  <div class="container-page relative">
    <div class="mx-auto max-w-2xl text-center">
      <p class="kicker text-gold">Les bénévoles du club</p>
      <h2 class="mt-4 text-5xl leading-none font-semibold tracking-tight sm:text-6xl">
        La Cour des Palmes
      </h2>
      <p class="mt-6 text-lg text-white/70">
        Ils font vivre le club toute l’année, bénévolement. Survolez ou touchez un médaillon pour
        les voir sous l’eau… et ouvrez l’œil, la Cour cache quelques secrets.
      </p>
    </div>

    {board.length > 0 && (
      <div class="mt-20">
        <p class="kicker text-center text-white/50">Le bureau</p>
        <h3 class="mt-2 text-center text-3xl font-semibold tracking-tight">Le Trône</h3>
        <ul
          data-board
          class="mt-12 flex flex-wrap justify-center gap-x-4 gap-y-12 sm:gap-x-12 sm:gap-y-14"
        >
          {board.map((member) => (
            <li>
              <MemberMedallion
                member={member}
                title={member.title}
                detail={member.role}
                size="large"
              />
            </li>
          ))}
        </ul>
      </div>
    )}

    {committee.length > 0 && (
      <div class="mt-24">
        <p class="kicker text-center text-white/50">Le comité directeur</p>
        <h3 class="mt-2 text-center text-3xl font-semibold tracking-tight">La Table Ronde</h3>
        <ul class="mt-12 flex flex-wrap justify-center gap-x-4 gap-y-12 sm:gap-x-8 sm:gap-y-14">
          {committee.map((member) => (
            <li>
              <MemberMedallion member={member} title={member.title} detail={member.role} />
            </li>
          ))}
        </ul>
      </div>
    )}

    {instructorGroups.length > 0 && (
      <div class="mt-24">
        <p class="kicker text-center text-white/50">Les encadrants</p>
        <h3 class="mt-2 text-center text-3xl font-semibold tracking-tight">L’École des Palmes</h3>
        <div class="mt-12 grid gap-16 lg:grid-cols-2 lg:gap-8">
          {instructorGroups.map((group) => (
            <div class="rounded-[2rem] bg-white/[0.03] px-3 py-10 ring-1 ring-white/10 sm:px-6">
              <p class="text-center font-display text-2xl font-semibold">{group.title}</p>
              <p class="mx-auto mt-2 max-w-sm text-center text-sm text-white/60">
                {group.description}
              </p>
              <ul class="mt-10 flex flex-wrap justify-center gap-x-4 gap-y-12 sm:gap-x-8 sm:gap-y-14">
                {group.members.map((member) => (
                  <li>
                    <MemberMedallion
                      member={member}
                      title={instructorTitleOf(member)}
                      detail={instructorLevels[member.instructorLevel].label}
                      badge={member.instructorLevel}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script>
  const BUBBLE_RAIN_WINDOW_MILLISECONDS = 4000

  const members = [...document.querySelectorAll<HTMLElement>('[data-member]')]
  const boardMembers = [...document.querySelectorAll<HTMLElement>('[data-board] [data-member]')]
  const bubbleRain = document.querySelector<HTMLElement>('[data-bubble-rain]')!

  const playEmblem = (member: HTMLElement) => {
    member.removeAttribute('data-emblem-play')
    void member.offsetWidth
    member.setAttribute('data-emblem-play', '')
  }

  const surface = (member: HTMLElement, delay: number) =>
    setTimeout(() => {
      member.setAttribute('data-surfaced', '')
      setTimeout(() => playEmblem(member), 900)
    }, delay)

  const rainBubbles = () => {
    const bubbles = Array.from({ length: 45 }, () => {
      const bubble = document.createElement('span')
      const size = 6 + Math.random() * 22
      bubble.className = 'bubble-rain-drop'
      bubble.style.cssText = `left:${Math.random() * 100}%; width:${size}px; height:${size}px; animation-duration:${2.6 + Math.random() * 2.4}s; animation-delay:${Math.random() * 1.2}s; --drift:${(Math.random() - 0.5) * 80}px`
      return bubble
    })
    bubbleRain.replaceChildren(...bubbles)
    setTimeout(() => bubbleRain.replaceChildren(), 6000)
  }

  const hoveredAt = new Map<HTMLElement, number>()

  const trackBoardHover = (member: HTMLElement) => {
    const now = Date.now()
    hoveredAt.set(member, now)
    const isWholeBoardRecent = boardMembers.every(
      (boardMember) => now - (hoveredAt.get(boardMember) ?? 0) < BUBBLE_RAIN_WINDOW_MILLISECONDS
    )
    if (boardMembers.length > 1 && isWholeBoardRecent) {
      hoveredAt.clear()
      rainBubbles()
    }
  }

  members.forEach((member) => {
    const toggle = member.querySelector<HTMLButtonElement>('[data-member-toggle]')!
    toggle.addEventListener('click', () => {
      const isDiving = member.toggleAttribute('data-diving')
      toggle.setAttribute('aria-pressed', String(isDiving))
    })
    toggle.addEventListener('pointerenter', () => playEmblem(member))
  })

  boardMembers.forEach((member) =>
    member
      .querySelector('[data-member-toggle]')!
      .addEventListener('pointerenter', () => trackBoardHover(member))
  )

  const surfaceObserver = new IntersectionObserver(
    (entries) =>
      entries
        .filter((entry) => entry.isIntersecting)
        .forEach((entry, entryIndex) => {
          surfaceObserver.unobserve(entry.target)
          surface(entry.target as HTMLElement, 300 + entryIndex * 160)
        }),
    { threshold: 0.6 }
  )

  members.forEach((member) => {
    if (member.getBoundingClientRect().top > window.innerHeight) {
      member.removeAttribute('data-surfaced')
    }
    surfaceObserver.observe(member)
  })
</script>

<style>
  :global(.bubble-rain-drop) {
    position: absolute;
    bottom: -40px;
    border-radius: 9999px;
    border: 1.5px solid rgb(255 255 255 / 0.75);
    background: radial-gradient(circle at 30% 30%, rgb(255 255 255 / 0.55), rgb(43 167 222 / 0.12));
    animation-name: bubble-rain;
    animation-timing-function: cubic-bezier(0.4, 0, 0.7, 1);
    animation-fill-mode: both;
  }

  @keyframes bubble-rain {
    from {
      transform: translate(0, 0);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    to {
      transform: translate(var(--drift), -115vh);
      opacity: 0.6;
    }
  }
</style>
