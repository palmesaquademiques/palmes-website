---
import type { Member } from '../../lib/queries'
import { groupTeam, instructorLevels } from '../../lib/team'
import Bubbles from '../ui/Bubbles.astro'
import MemberMedallion from './MemberMedallion.astro'

type Props = { members: Member[] }

const { board, committee, poolInstructors, seaInstructors } = groupTeam(Astro.props.members)

const instructorGroups = [
  {
    title: 'À la piscine',
    description: 'Les initiateurs forment les futurs niveaux 1, le mardi soir.',
    members: poolInstructors
  },
  {
    title: 'En mer',
    description: 'Moniteurs et guides de palanquée encadrent les plongées des sorties.',
    members: seaInstructors
  }
].filter((group) => group.members.length > 0)
---

<section
  id="equipe"
  data-team
  class="relative isolate overflow-clip bg-abyss py-24 text-white sm:py-32"
>
  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-0 -z-10 h-[40rem] bg-[radial-gradient(ellipse_at_50%_0%,rgb(232_196_106/0.14),transparent_60%)]"
  ></div>
  <Bubbles count={10} />

  <div class="container-page relative">
    <div class="mx-auto max-w-2xl text-center">
      <p class="kicker text-gold">Les bénévoles du club</p>
      <h2 class="mt-4 text-5xl leading-none font-semibold tracking-tight sm:text-6xl">
        L’Ordre des Palmes Aquadémiques
      </h2>
      <p class="mt-6 text-lg text-white/70">
        Ils font vivre le club toute l’année, bénévolement. Survolez ou touchez un médaillon pour
        les voir sous l’eau.
      </p>
    </div>

    {board.length > 0 && (
      <div class="mt-20">
        <p class="kicker text-center text-white/50">Le conseil de la couronne</p>
        <h3 class="mt-2 text-center text-3xl font-semibold tracking-tight">Le bureau</h3>
        <ul class="mt-12 flex flex-wrap justify-center gap-x-4 gap-y-12 sm:gap-x-12 sm:gap-y-14">
          {board.map((member) => (
            <li>
              <MemberMedallion
                member={member}
                title={member.title}
                detail={member.role}
                size="large"
              />
            </li>
          ))}
        </ul>
      </div>
    )}

    {committee.length > 0 && (
      <div class="mt-24">
        <p class="kicker text-center text-white/50">La Table Ronde</p>
        <h3 class="mt-2 text-center text-3xl font-semibold tracking-tight">Le comité directeur</h3>
        <ul class="mt-12 flex flex-wrap justify-center gap-x-4 gap-y-12 sm:gap-x-8 sm:gap-y-14">
          {committee.map((member) => (
            <li>
              <MemberMedallion member={member} title={member.title} detail={member.role} />
            </li>
          ))}
        </ul>
      </div>
    )}

    {instructorGroups.length > 0 && (
      <div class="mt-24">
        <p class="kicker text-center text-white/50">L’école de l’Ordre</p>
        <h3 class="mt-2 text-center text-3xl font-semibold tracking-tight">Les encadrants</h3>
        <div class="mt-12 grid gap-16 lg:grid-cols-2 lg:gap-8">
          {instructorGroups.map((group) => (
            <div class="rounded-[2rem] bg-white/[0.03] px-3 py-10 ring-1 ring-white/10 sm:px-6">
              <p class="text-center font-display text-2xl font-semibold">{group.title}</p>
              <p class="mx-auto mt-2 max-w-sm text-center text-sm text-white/60">
                {group.description}
              </p>
              <ul class="mt-10 flex flex-wrap justify-center gap-x-4 gap-y-12 sm:gap-x-8 sm:gap-y-14">
                {group.members.map((member) => (
                  <li>
                    <MemberMedallion
                      member={member}
                      title={instructorLevels[member.instructorLevel].title}
                      detail={instructorLevels[member.instructorLevel].label}
                      badge={member.instructorLevel}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script>
  const members = [...document.querySelectorAll<HTMLElement>('[data-member]')]

  members.forEach((member) => {
    const toggle = member.querySelector<HTMLButtonElement>('[data-member-toggle]')!
    toggle.addEventListener('click', () => {
      const isDiving = member.toggleAttribute('data-diving')
      toggle.setAttribute('aria-pressed', String(isDiving))
    })
  })

  const surfaceObserver = new IntersectionObserver(
    (entries) =>
      entries
        .filter((entry) => entry.isIntersecting)
        .forEach((entry, entryIndex) => {
          surfaceObserver.unobserve(entry.target)
          setTimeout(() => entry.target.setAttribute('data-surfaced', ''), 300 + entryIndex * 160)
        }),
    { threshold: 0.6 }
  )

  members
    .filter((member) => member.getBoundingClientRect().top > window.innerHeight)
    .forEach((member) => {
      member.removeAttribute('data-surfaced')
      surfaceObserver.observe(member)
    })
</script>
