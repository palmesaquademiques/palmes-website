---
import { formatShortDateRange } from '../../lib/dates'
import type { TripSummary } from '../../lib/queries'
import { displayStatus } from '../../lib/trips'
import Icon from '../ui/Icon.astro'
import SanityImage from '../ui/SanityImage.astro'
import StatusBadge from '../ui/StatusBadge.astro'

type Props = { trip: TripSummary; today: string; class?: string; sizes?: string }

const { trip, today, class: className, sizes = '(min-width: 1024px) 380px, 78vw' } = Astro.props

const status = displayStatus(trip, today)
---

<a
  href={`/les-sorties/${trip.slug}`}
  class:list={[
    'group relative isolate flex aspect-[3/4] flex-col justify-between overflow-hidden rounded-[1.75rem] bg-deep p-5 text-white ring-1 ring-white/10 transition duration-500 ease-swim hover:-translate-y-1 hover:ring-lagoon/50',
    className
  ]}
>
  {trip.coverImage ? (
    <SanityImage
      image={trip.coverImage}
      aspectRatio={3 / 4}
      widths={[320, 480, 640, 800]}
      sizes={sizes}
      class="absolute inset-0 -z-10 size-full object-cover transition duration-[1.2s] ease-swim group-hover:scale-110"
      style={`view-transition-name: trip-${trip.slug};`}
    />
  ) : (
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_30%_20%,var(--color-ocean),var(--color-deep)_60%)]"
      style={`view-transition-name: trip-${trip.slug};`}
    />
  )}
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-abyss via-abyss/30 to-abyss/10"
    aria-hidden="true"
  ></div>

  <div class="flex items-start justify-between gap-2">
    <span class="rounded-full bg-abyss/45 px-3 py-1.5 font-display text-sm font-semibold backdrop-blur-md">
      {formatShortDateRange(trip.startDate, trip.endDate)}
    </span>
    <StatusBadge status={status} />
  </div>

  <div>
    <h3 class="text-3xl leading-none font-semibold tracking-tight sm:text-4xl">{trip.title}</h3>
    {trip.summary && <p class="mt-3 line-clamp-2 text-sm text-white/75">{trip.summary}</p>}
    <span class="mt-5 flex size-11 items-center justify-center rounded-full bg-white/15 backdrop-blur-md transition duration-500 ease-swim group-hover:-rotate-45 group-hover:bg-coral group-hover:text-ink">
      <Icon name="arrowRight" />
    </span>
  </div>
</a>
