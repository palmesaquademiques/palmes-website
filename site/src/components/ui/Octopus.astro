---
type Props = { uid: string; isInLove?: boolean; class?: string }

const { uid, isInLove = false, class: className } = Astro.props

const TENTACLES = [
  'M-16 8Q-23 28-31 42q4 3 6-2',
  'M-10 8Q-14 28-18 42q4 3 6-2',
  'M-3 8Q-5 28-6 42q4 3 6-2',
  'M3 8Q5 28 6 42q4 3 6-2',
  'M10 8Q14 28 18 42q4 3 6-2',
  'M16 8Q23 28 31 42q4 3 6-2'
]

const HEART = 'M0 4.5-5-.5A2.8 2.8 0 0 1 0-3 2.8 2.8 0 0 1 5-.5Z'

const floatingHearts = [
  { position: 'top-[8%] -right-[12%] w-[22%]', delay: 0.9 },
  { position: 'top-[22%] -left-[14%] w-[16%]', delay: 1.6 },
  { position: '-top-[6%] left-[30%] w-[14%]', delay: 2.3 }
]

const mantleGradientId = `octopus-mantle-${uid}`
---

<span aria-hidden="true" class:list={['relative block', className]}>
  <svg viewBox="-34 -36 68 84" class="w-full overflow-visible">
    <defs>
      <radialGradient
        id={mantleGradientId}
        gradientUnits="userSpaceOnUse"
        cx="0"
        cy="-6"
        r="29"
        fx="-8"
        fy="-18"
      >
        <stop offset="0" stop-color="#ffb39a"></stop>
        <stop offset="0.55" stop-color="#ff7a59"></stop>
        <stop offset="1" stop-color="#de4f31"></stop>
      </radialGradient>
    </defs>
    {TENTACLES.map((tentacle, tentacleIndex) => (
      <g
        class="tentacle"
        fill="none"
        stroke-linecap="round"
        style={`animation-delay:-${tentacleIndex * 0.2}s`}
      >
        <path d={tentacle} stroke="white" stroke-width="9.5" />
        <path d={tentacle} stroke="#e4583a" stroke-width="6.5" />
      </g>
    ))}
    <ellipse
      cx="0"
      cy="-6"
      rx="21"
      ry="26"
      fill={`url(#${mantleGradientId})`}
      stroke="white"
      stroke-width="2"
    ></ellipse>
    <circle cx="-7" cy="-20" r="3" fill="rgb(200 60 35 / 0.45)"></circle>
    <circle cx="6" cy="-24" r="2.4" fill="rgb(200 60 35 / 0.45)"></circle>
    <circle cx="9" cy="-12" r="2" fill="rgb(200 60 35 / 0.45)"></circle>
    {[-8, 8].map((eyeX) => (
      <g>
        <circle cx={eyeX} cy="2" r="6.5" fill="white" />
        <rect
          class:list={[isInLove && 'melting-pupil']}
          x={eyeX - 1.5}
          y="0.5"
          width="6"
          height="3.2"
          rx="1.6"
          fill="#1b1030"
        />
        {isInLove && (
          <path class="heart-eye" d={HEART} transform={`translate(${eyeX} 2.4)`} fill="#ff4d6d" />
        )}
      </g>
    ))}
  </svg>
  {isInLove &&
    floatingHearts.map((heart) => (
      <span
        class:list={['floating-heart absolute', heart.position]}
        style={`animation-delay:${heart.delay}s`}
      >
        <svg viewBox="-6 -6 12 12" class="w-full overflow-visible">
          <path d={HEART} fill="#ff4d6d" stroke="white" stroke-width="1.2" />
        </svg>
      </span>
    ))}
</span>

<style>
  .tentacle,
  .heart-eye {
    transform-box: fill-box;
  }

  .tentacle {
    transform-origin: 50% 0%;
  }

  .heart-eye {
    transform-origin: center;
  }

  .floating-heart {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tentacle {
      animation: tentacle-sway 1.2s ease-in-out infinite alternate;
    }

    .melting-pupil {
      animation: pupil-melt 0.3s ease-in 0.6s both;
    }

    .heart-eye {
      animation:
        heart-eye-pop 0.35s cubic-bezier(0.3, 1.8, 0.5, 1) 0.65s both,
        heart-eye-beat 0.8s ease-in-out 1s infinite;
    }

    .floating-heart {
      animation: heart-float 2.4s ease-out infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .melting-pupil {
      opacity: 0;
    }
  }

  @keyframes tentacle-sway {
    from {
      rotate: -7deg;
    }
    to {
      rotate: 7deg;
    }
  }

  @keyframes pupil-melt {
    to {
      opacity: 0;
      scale: 0.2;
    }
  }

  @keyframes heart-eye-pop {
    from {
      opacity: 0;
      scale: 0;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  @keyframes heart-eye-beat {
    50% {
      scale: 1.25;
    }
  }

  @keyframes heart-float {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(0.3);
    }
    15% {
      opacity: 1;
      transform: translate(-10%, -30%) scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: translate(-60%, -260%) scale(1.1) rotate(-15deg);
    }
  }
</style>
