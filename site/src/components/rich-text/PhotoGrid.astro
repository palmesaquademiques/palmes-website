---
import type { SanityImage } from '../../lib/queries'
import { imageUrl } from '../../lib/sanity'
import SanityImageComponent from '../ui/SanityImage.astro'

type Props = { node: { images: SanityImage[]; caption?: string } }

type FirstPhotoSpan = 'none' | 'square' | 'wide' | 'banner'

const { node } = Astro.props
const images = node.images ?? []

const layoutFor = (count: number): { columns: 1 | 2 | 3; firstPhotoSpan: FirstPhotoSpan } => {
  if (count === 1) return { columns: 1, firstPhotoSpan: 'none' }
  if (count === 2 || count === 4) return { columns: 2, firstPhotoSpan: 'none' }
  if (count % 3 === 0) return { columns: 3, firstPhotoSpan: 'square' }
  return { columns: 3, firstPhotoSpan: count % 3 === 2 ? 'wide' : 'banner' }
}

const { columns, firstPhotoSpan } = layoutFor(images.length)

const spanClasses: Record<FirstPhotoSpan, string> = {
  none: '',
  square: 'col-span-2 row-span-2',
  wide: 'col-span-2',
  banner: 'col-span-3'
}

const aspectRatios: Record<FirstPhotoSpan, number> = { none: 1, square: 1, wide: 2, banner: 3 }

const isFirstSpanned = (imageIndex: number) => imageIndex === 0 && firstPhotoSpan !== 'none'
---

<figure class="not-prose my-10">
  <div
    class:list={[
      'grid gap-2 sm:gap-3',
      { 1: 'grid-cols-1', 2: 'grid-cols-2', 3: 'grid-cols-3' }[columns]
    ]}
  >
    {images.map((image, imageIndex) => (
      <a
        href={imageUrl(image).width(2000).url()}
        data-lightbox="article"
        data-caption={image.alt ?? node.caption ?? ''}
        class:list={[
          'group overflow-hidden rounded-xl',
          isFirstSpanned(imageIndex) && spanClasses[firstPhotoSpan]
        ]}
      >
        <SanityImageComponent
          image={image}
          aspectRatio={
            columns === 1
              ? undefined
              : isFirstSpanned(imageIndex)
                ? aspectRatios[firstPhotoSpan]
                : 1
          }
          widths={[320, 480, 800, 1200, 1600]}
          sizes={
            columns === 1 || isFirstSpanned(imageIndex)
              ? '(min-width: 56rem) 52rem, 100vw'
              : `(min-width: 56rem) ${columns === 2 ? 26 : 17}rem, ${columns === 2 ? 50 : 33}vw`
          }
          class="size-full object-cover transition duration-700 ease-swim group-hover:scale-105"
        />
      </a>
    ))}
  </div>
  {node.caption && (
    <figcaption class="mt-3 text-center text-sm text-slate-500">{node.caption}</figcaption>
  )}
</figure>
