---
import type { Mark } from 'astro-portabletext/types'

type Props = { node: Mark<{ href: string }> }

const { href } = Astro.props.node.markDef
const isExternal = /^https?:\/\//.test(href) && !href.includes('lespalmesaquademiques.fr')
---

<a href={href} {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
  <slot />
</a>
