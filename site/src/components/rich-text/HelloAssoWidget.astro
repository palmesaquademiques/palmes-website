---
type Props = { url: string; title?: string | null }

const { url, title } = Astro.props

const pageUrl = url.replace(/\/widget\/?$/, '').replace(/\/$/, '')
const widgetUrl = `${pageUrl}/widget`
---

<div class="not-prose my-10">
  {title && <p class="mb-4 font-display text-2xl font-semibold text-ink">{title}</p>}
  <div class="overflow-hidden rounded-3xl bg-white p-2 shadow-[0_30px_80px_-40px] shadow-deep/40 ring-1 ring-ink/5">
    <iframe
      data-helloasso
      src={widgetUrl}
      title={`${title ?? 'Formulaire'} sur HelloAsso`}
      loading="lazy"
      allow="payment"
      allowtransparency="true"
      class="block h-[760px] w-full rounded-2xl border-0"
    ></iframe>
  </div>
  <p class="mt-3 text-center text-sm text-slate-500">
    Le formulaire ne s’affiche pas ?
    <a
      href={pageUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="font-medium text-ocean underline underline-offset-4"
    >
      Ouvrir directement sur HelloAsso
    </a>
  </p>
</div>

<script>
  window.addEventListener('message', (event) => {
    if (!new URL(event.origin).hostname.endsWith('helloasso.com')) return
    const height = Number(event.data?.height)
    if (!height) return

    const sourceFrame = [
      ...document.querySelectorAll<HTMLIFrameElement>('iframe[data-helloasso]')
    ].find((frame) => frame.contentWindow === event.source)
    if (sourceFrame) sourceFrame.style.height = `${height}px`
  })
</script>
