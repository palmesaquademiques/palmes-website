---
import type { SanityImage as SanityImageType } from '../../lib/queries'
import Bubbles from '../ui/Bubbles.astro'
import SanityImage from '../ui/SanityImage.astro'
import Wave from '../ui/Wave.astro'

type Props = {
  kicker: string
  title: string
  intro?: string | null
  image?: SanityImageType | null
  imageTransitionName?: string
  compact?: boolean
}

const { kicker, title, intro, image, imageTransitionName, compact = false } = Astro.props
---

<section class="relative isolate overflow-hidden bg-surface pt-[calc(var(--spacing-header)+4.5rem)] pb-28 text-ink sm:pb-36">
  {image && (
    <div class="absolute inset-0 -z-10 overflow-hidden lg:left-[38%]">
      <SanityImage
        image={image}
        sizes="(min-width: 1024px) 62vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="size-full animate-ken-burns object-cover opacity-25 lg:opacity-100"
        style={imageTransitionName && `view-transition-name: ${imageTransitionName};`}
      />
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-surface/50 lg:bg-transparent lg:bg-gradient-to-r lg:from-surface lg:via-surface/60 lg:to-transparent"
      />
    </div>
  )}
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_15%_0%,rgb(43_167_222/0.25),transparent_55%)]"
  ></div>
  <Bubbles count={8} tone="light" />

  <div class="container-page relative">
    <slot name="before" />
    <p class="kicker animate-fade-up text-ocean">{kicker}</p>
    <h1
      class:list={[
        'mt-5 animate-fade-up font-bold tracking-[-0.03em] [animation-delay:120ms]',
        compact
          ? 'max-w-3xl text-[clamp(2.6rem,6vw,4.8rem)] leading-[0.95]'
          : 'max-w-4xl text-[clamp(3rem,8vw,6.5rem)] leading-[0.9]'
      ]}
    >
      {title}
    </h1>
    {intro && (
      <p class="mt-7 max-w-2xl animate-fade-up text-lg leading-relaxed text-slate-700 [animation-delay:240ms]">
        {intro}
      </p>
    )}
    <slot />
  </div>

  <Wave class="absolute inset-x-0 -bottom-px text-sand" />
</section>
