---
import { navigationLinks, siteConfig } from '../../site.config'
import Wave from '../ui/Wave.astro'

const socialLinks = [
  {
    label: 'Instagram',
    href: siteConfig.instagram,
    path: 'M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2M12 0C8.7 0 8.3 0 7.1.1 5.8.1 4.9.3 4.1.6c-.8.3-1.5.7-2.1 1.4C1.3 2.6.9 3.3.6 4.1.3 4.9.1 5.8.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.1 1.3.3 2.1.6 2.9.3.8.7 1.5 1.4 2.1.7.7 1.3 1.1 2.1 1.4.8.3 1.6.5 2.9.6 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c1.3-.1 2.1-.3 2.9-.6.8-.3 1.5-.7 2.1-1.4.7-.7 1.1-1.3 1.4-2.1.3-.8.5-1.6.6-2.9.1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.1-1.3-.3-2.1-.6-2.9-.3-.8-.7-1.5-1.4-2.1C21.4 1.3 20.7.9 19.9.6 19.1.3 18.2.1 16.9.1 15.7 0 15.3 0 12 0Zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9Z'
  }
]

const currentYear = new Date().getFullYear()
---

<footer class="relative bg-abyss text-white/70">
  <Wave class="absolute inset-x-0 bottom-full text-abyss" />

  <div class="container-page grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <a href="/" class="flex items-center gap-3 text-white">
        <img src="/logo.png" alt="" width="56" height="56" class="size-14" loading="lazy" />
        <span class="font-display text-xl leading-tight font-semibold">{siteConfig.name}</span>
      </a>
      <p class="mt-5 text-sm leading-relaxed">{siteConfig.description}</p>
      <ul class="mt-6 flex gap-2">
        {socialLinks.map((socialLink) => (
          <li>
            <a
              href={socialLink.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex size-10 items-center justify-center rounded-full border border-white/15 text-white transition hover:border-lagoon hover:bg-lagoon/15"
            >
              <span class="sr-only">{socialLink.label}</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                <path d={socialLink.path} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label="Plan du site">
      <p class="kicker text-lagoon">Le site</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href="/" class="transition hover:text-white">
            Accueil
          </a>
        </li>
        {navigationLinks.map((link) => (
          <li>
            <a href={link.href} class="transition hover:text-white">
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/inscriptions" class="transition hover:text-white">
            Inscriptions
          </a>
        </li>
        <li>
          <a href="/jeu" class="transition hover:text-white">
            Le jeu du poulpe 🐙
          </a>
        </li>
      </ul>
    </nav>

    <div>
      <p class="kicker text-lagoon">Nous trouver</p>
      <address class="mt-4 space-y-2 text-sm not-italic">
        <p class="text-white">Piscine Léo Lagrange</p>
        <p>1 place Riquet, 31000 Toulouse</p>
        <p>Le mardi soir, de septembre à juin</p>
        <p>
          <a
            href={`mailto:${siteConfig.email}`}
            class="text-white underline decoration-lagoon/50 underline-offset-4 transition hover:decoration-lagoon"
          >
            {siteConfig.email}
          </a>
        </p>
      </address>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-white/50 sm:flex-row sm:justify-between">
      <p>
        © {currentYear} {siteConfig.name} · Club affilié à la FFESSM ·{' '}
        <a href="/mentions-legales" class="transition hover:text-white">
          Mentions légales
        </a>
      </p>
      <p>Fait avec 🤿 à {siteConfig.city}</p>
    </div>
  </div>
</footer>
