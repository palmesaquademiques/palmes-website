---
import type { PostSummary } from '../../lib/queries'
import PostCard from '../cards/PostCard.astro'
import Icon from '../ui/Icon.astro'

type Props = { posts: PostSummary[] }

const [featuredPost, ...otherPosts] = Astro.props.posts
---

{featuredPost && (
  <section class="relative py-24 text-white sm:py-32">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker text-lagoon" data-reveal>
            −40 m · Carnet de plongée
          </p>
          <h2
            class="mt-4 text-5xl leading-none font-semibold tracking-tight sm:text-6xl"
            data-reveal
          >
            Les dernières actus
          </h2>
        </div>
        <a href="/blog" class="button-ghost" data-reveal>
          Tout le blog <Icon name="arrowRight" class="size-4" />
        </a>
      </div>

      <div class="mt-14 grid gap-12 lg:grid-cols-[1.25fr_1fr] lg:gap-16">
        <div data-reveal>
          <PostCard post={featuredPost} featured tone="dark" />
        </div>
        <div class="flex flex-col justify-center gap-10">
          {otherPosts.map((post) => (
            <div data-reveal>
              <PostCard post={post} tone="dark" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
